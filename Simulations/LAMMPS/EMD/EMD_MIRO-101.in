units           real
atom_style      full
dimension       3
boundary        p p p
# --------------------------------------

pair_style      lj/cut 12.500
bond_style      harmonic
angle_style     hybrid fourier cosine/periodic
dihedral_style  harmonic
improper_style  fourier
# --------------------------------------

pair_modify     tail yes mix arithmetic
special_bonds   lj/coul 0.0 0.0 1.0
dielectric      1.0
box tilt        large
read_data       data

# --------------------------------------
# Monitoreo y corrección del centro de masa
compute         mycom all com
# Añadimos c_mycom[1-3] al thermo_style más abajo
fix             drift all momentum 100 linear 1 1 1 rescale

# --------------------------------------

#### Simulation Parameters ####
variable TT equal 300           # Temperatura objetivo
variable dt equal 1.0           # Paso de tiempo (fs)
variable seed equal 111111
variable kCal2J equal 4184.0/6.02214e23

### PASOS DE MINIMIZACION
fix 		1 all box/relax x 0.0 y 0.0 z 0.0 couple xy vmax 0.0001
minimize	1.0e-15  1.0e-21  100000  100000
min_modify	dmax 0.2 line quadratic
unfix		1
# --------------------------------------

### VARIABLES 
variable mystep equal step
variable mytemp equal temp
variable mypress equal press
variable mype equal pe
variable myetotal equal etotal
variable myvol equal vol
variable mylx equal lx
variable myly equal ly
variable mylz equal lz

variable px atom mass*vx
variable py atom mass*vy
variable pz atom mass*vz
compute P all reduce sum v_px v_py v_pz
variable m_i atom mass
compute M all reduce sum v_m_i
variable vcomx equal c_P[1]/c_M
variable vcomy equal c_P[2]/c_M
variable vcomz equal c_P[3]/c_M

# --------------------------------------


### INITIAL CONDITION
velocity all create ${TT} ${seed} dist gaussian mom yes rot yes
timestep        ${dt}
thermo          50
thermo_style    custom step temp press pe etotal vol lx ly lz c_mycom[1] c_mycom[2] c_mycom[3] v_vcomx v_vcomy v_vcomz
reset_timestep 0
# --------------------------------------


### Equilibration in NPT1 ###
variable        pdamp1      equal $(1000.0*dt)
variable        tdamp1      equal $(100.0*dt)
fix             NPT1 all npt temp ${TT} ${TT} ${tdamp1} iso 1.00 1.00 ${pdamp1}
fix 		11 all ave/time 1 1 2 v_mytemp v_mypress v_mype v_myetotal v_myvol v_mylx v_myly v_mylz v_dt file NPT_1000_100.dat
run             100000 # 100ps
unfix           NPT1
unfix		11
# --------------------------------------

timestep 0.5 			# 0.5fs
variable        dt equal 0.5

### Equilibration in NPT2 ###
variable        pdamp2      equal $(5000.0*dt)
variable        tdamp2      equal $(500.0*dt)
fix             NPT2 all npt temp ${TT} ${TT} ${tdamp2} iso 1.00 1.00 ${pdamp2}
fix 		12 all ave/time 1 1 2 v_mytemp v_mypress v_mype v_myetotal v_myvol v_mylx v_myly v_mylz v_dt file NPT_5000_500.dat
run             100000 # 50ps
unfix           NPT2
unfix		12
# --------------------------------------

### Equilibration in NVT1 ###
fix             NVT1 all nvt temp ${TT} ${TT} $(1000.0*dt)
fix 		13 all ave/time 1 1 2 v_mytemp v_mypress v_mype v_myetotal v_myvol v_mylx v_myly v_mylz v_dt file NVT_1000.dat
run             100000 # 50ps
unfix           NVT1
unfix		13
# --------------------------------------

timestep 0.2			 # 0.2fs
variable        dt equal 0.2

### Equilibration in NVT2 ###
fix             NVT2 all nvt temp ${TT} ${TT} $(5000.0*dt)
fix 		14 all ave/time 1 1 2 v_mytemp v_mypress v_mype v_myetotal v_myvol v_mylx v_myly v_mylz v_dt file NVT_5000.dat
run             100000 # 20ps
unfix           NVT2
unfix		14
# --------------------------------------

### Equilibration in NVE ###
fix             NVE1 all nve
fix 		15 all ave/time 1 1 2 v_mytemp v_mypress v_mype v_myetotal v_myvol v_mylx v_myly v_mylz v_dt file NVE1.dat
run             100000 # 20ps
unfix           NVE1
unfix		15
# --------------------------------------

reset_timestep 0
#######################################
### THERMAL FLUX CALCULATION IN NVE ###
#######################################

fix             NVE all nve

variable        V equal vol
variable        TE equal temp
variable        PR equal press
variable 	fname string flux_Miro-101_4_EMD_${TT}K_${dt}fs_1ss.dat

compute         PE all pe/atom
compute         KE all ke/atom
compute         SA all stress/atom NULL virial
compute         flux all heat/flux KE PE SA

variable Fx equal (c_flux[1]*${kCal2J}*1e5)
variable Fy equal (c_flux[2]*${kCal2J}*1e5)
variable Fz equal (c_flux[3]*${kCal2J}*1e5)

fix ff all print 1 "${mystep} ${Fx} ${Fy} ${Fz} ${myvol} ${mytemp} ${mypress} ${dt}" file ${fname} screen no

run             5000000  #1000ps
# --------------------------------------

unfix		NVE
unfix		ff
unfix		drift