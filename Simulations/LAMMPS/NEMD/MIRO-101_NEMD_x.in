## LAMMPS NEMD Script para medir conductividad termica en MIRO-101

log         log.MIRO-101_24x3x2 append
units       real
dimension   3
boundary    p p p
atom_style  full
# --------------------------------------

### CELDA Y ATOMOS
### POTENCIAL
pair_style      lj/cut 12.5
bond_style      harmonic
angle_style     hybrid cosine/periodic fourier
dihedral_style  harmonic
improper_style  fourier

dielectric      1.0
special_bonds   lj/coul 0.0 0.0 1.0
pair_modify     tail yes mix arithmetic
box tilt        large
read_data       data.MIRO-101_14x3x3

thermo      10
thermo_style    custom step temp press pe etotal vol lx ly lz
# --------------------------------------

#### PARAMETROS DE SIMULACION 
variable        T equal 300
variable        V equal vol
variable        dt equal 1   #1fs
timestep 1	
# --------------------------------------

### PASOS DE MINIMIZACION  
min_style sd
minimize 1e-5 1e-5 10000 10000

min_style cg
minimize 1e-8 1e-8 10000 10000

dump        1 all xyz 1 final1.xyz
run         0
undump      1

fix 1 all box/relax x 1.0 y 1.0 z 1.0 vmax 0.0001
minimize	1.0e-15  1.0e-21  50000  50000
min_modify	dmax 0.2 line quadratic
unfix		1

dump        2 all xyz 1 final2.xyz
run         0
undump      2
thermo      100
# --------------------------------------

### VARIABLES 
variable mystep equal step
variable mytemp equal temp
variable mypress equal press
variable mype equal pe
variable myetotal equal etotal
variable myvol equal vol
variable mylx equal lx
variable myly equal ly
variable mylz equal lz
# --------------------------------------

reset_timestep 0
velocity        all create 300 123456 dist gaussian
### Equilibration in NPT ###
variable        pdamp1      equal $(1000.0*dt)
variable        tdamp1      equal $(100.0*dt)
fix             NPT1 all npt temp $T $T ${tdamp1} iso 1.00 1.00 ${pdamp1}
fix 		11 all ave/time 1 1 2 v_mytemp v_mypress v_mype v_myetotal v_myvol v_mylx v_myly v_mylz v_dt file NPT_1000_100.dat
run             10000 # 10ps
unfix           NPT1
unfix		11

dump        3 all xyz 1 NPT_1000_100.xyz
run         0
undump      3
# --------------------------------------

### Equilibration in NPT ###
variable        pdamp2      equal $(5000.0*dt)
variable        tdamp2      equal $(500.0*dt)
fix             NPT2 all npt temp $T $T ${tdamp2} iso 1.00 1.00 ${pdamp2}
fix 		12 all ave/time 1 1 2 v_mytemp v_mypress v_mype v_myetotal v_myvol v_mylx v_myly v_mylz v_dt file NPT_5000_500.dat
run             20000 # 20ps
unfix           NPT2
unfix		12

dump        4 all xyz 1 NPT_5000_500.xyz
run         0
undump      4
# --------------------------------------

### Equilibration in NPT ###
variable        pdamp3      equal $(10000.0*dt)
variable        tdamp3      equal $(1000.0*dt)
fix             NPT3 all npt temp $T $T ${tdamp3} iso 1.00 1.00 ${pdamp3}
fix 		13 all ave/time 1 1 2 v_mytemp v_mypress v_mype v_myetotal v_myvol v_mylx v_myly v_mylz v_dt file NPT_10000_1000.dat
run             40000 # 40ps
unfix           NPT3
unfix		13
# --------------------------------------

### Equilibration in NVT ###
fix             NVT1 all nvt temp 300 300 $(1000.0*dt)
fix 		14 all ave/time 1 1 2 v_mytemp v_mypress v_mype v_myetotal v_myvol v_mylx v_myly v_mylz v_dt file NVT_1000.dat
run             50000 # 50ps
unfix           NVT1
unfix		14
# --------------------------------------

# Definicion de slabs con style block

# Fracci n deseada para cada zona t rmica
variable f equal 0.125

# Largo de la caja en X (convertido a unidades absolutas)
variable llx equal "xhi - xlo"

# L mites absolutos para zona caliente (de 0 a f   Lx)
variable x_hot_lo equal "xlo"
variable x_hot_hi equal "xlo + v_f * v_llx"

# L mites absolutos para zona fr a (desde 0.5 Lx hasta 0.5 Lx + f Lx)
variable x_cold_lo equal "xlo + 0.5 * v_llx"
variable x_cold_hi equal "xlo + (0.5 + v_f) * v_llx"

# Crear regiones en unidades absolutas
region hot  block ${x_hot_lo} ${x_hot_hi} INF INF INF INF  units box
region cold block ${x_cold_lo} ${x_cold_hi} INF INF INF INF  units box


#region hot   block INF INF INF INF 0.0 v_f  units fraction
#region mid1  block INF INF INF INF v_f 0.5 units box

#region cold block INF INF INF INF 0.5 (0.5+v_f) units fraction
#region mid2  block INF INF INF INF (0.5+v_f) 1 units box

group   hot    region  hot
group 	cold   region  cold
#group   mid1   region  mid1
#group 	mid2   region  mid2

reset_timestep 0
# --------------------------------------

# PRE1-Termostatos NEMD
fix         eq1 all nve
fix hotf1   hot  langevin 320 320 100 492845 tally yes
fix coldf1  cold langevin 280 280 100 298347 tally yes

compute Thot hot temp/region hot
compute Tcold cold temp/region cold
thermo_style custom step temp c_Thot c_Tcold f_hotf1 f_coldf1
thermo      500

run 20000 # 20ps
unfix eq1
unfix hotf1
unfix coldf1
# --------------------------------------

reset_timestep 0
timestep 0.5			 # 0.5fs
variable        dt equal 0.5

# PRE2-Termostatos NEMD
fix         eq2 all nve
fix hotf2   hot  langevin 320 320 500 492845 tally yes
fix coldf2  cold langevin 280 280 500 298347 tally yes

thermo_style custom step temp c_Thot c_Tcold f_hotf2 f_coldf2

run 100000 # 50ps
unfix eq2
unfix hotf2
unfix coldf2
# --------------------------------------

reset_timestep 0
# Termostatos NEMD
fix         eq all nve
fix hotf   hot  langevin 320 320 1000.0 492845 tally yes
fix coldf  cold langevin 280 280 1000.0 298347 tally yes
#fix_modify hotf  temp Thot
#fix_modify coldf temp Tcold

# Promedio de perfil
compute sp all chunk/atom bin/1d x lower 4 units box

fix prof all ave/chunk 1 2000 2000 sp temp file temp.profile norm sample
fix 7 	 all ave/time 1 2000 2000 c_Thot c_Tcold f_hotf f_coldf v_mylx v_myly v_mylz v_dt file NEMD_260-340.dat

thermo_style custom step temp c_Thot c_Tcold f_hotf f_coldf
thermo      500

# Produccion NEMD
run         1000000


unfix eq
unfix hotf
unfix coldf
unfix prof
unfix 7

